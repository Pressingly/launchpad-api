# launchpad-api configuration contract. Every setting is an environment variable
# (src/config.py); names are case-insensitive, no prefix.

# Postgres, as launchpad_api_user (read+write on foss_users, append-only audit)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=launchpad
DB_USER=launchpad_api_user
DB_PASSWORD=CHANGE_ME

# SMTP for verification emails
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
FROM_ADDRESS=noreply@askii.ai
FROM_NAME=FOSS Launchpad

# Rate limiter backing store
REDIS_URL=redis://valkey:6379/11

# Portal host the verification link points at
PLATFORM_PROTOCOL=https
PLATFORM_DOMAIN=foss.local.dev
VERIFICATION_LINK_EXPIRY_HOURS=24

# Verify-gate. MUST equal the SYNTHETIC_EMAIL_DOMAIN mpass-auth-proxy uses; a
# mismatch silently waves verified users through on their synthetic address.
SYNTHETIC_EMAIL_DOMAIN=CHANGE_ME
GATE_CACHE_TTL_SECONDS=10

# After a user verifies: "skip" completes them at once (no pre-existing app
# accounts under their synthetic address), "manual" holds them until an operator
# relinks and completes them with the ops override. Empty completes nobody.
LAUNCHPAD_RELINK_RUNNER=skip

# Rate limits (defaults shown)
RATE_LIMIT_SUBMIT_PER_HOUR=3
RATE_LIMIT_SUBMIT_PER_DAY=10
RATE_LIMIT_RESEND_PER_MINUTE=1
RATE_LIMIT_RESEND_PER_DAY=3
RATE_LIMIT_GLOBAL_PER_DAY=500
